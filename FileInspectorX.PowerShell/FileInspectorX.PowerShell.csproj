<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
        <TargetFrameworks Condition=" '$([MSBuild]::IsOsPlatform(`Windows`))' ">
            netstandard2.0;net472;net8.0
        </TargetFrameworks>
        <TargetFrameworks
            Condition=" '$([MSBuild]::IsOsPlatform(`OSX`))'  Or '$([MSBuild]::IsOsPlatform(`Linux`))' ">
            net8.0
        </TargetFrameworks>
        <Title>FileInspectorX PowerShell Module</Title>
        <Description>PowerShell module for the FileInspectorX library. Exposes thin cmdlets over
            content detection and file analysis APIs.</Description>
        <AssemblyName>FileInspectorX.PowerShell</AssemblyName>
        <AssemblyTitle>FileInspectorX PowerShell Module</AssemblyTitle>
        <VersionPrefix>1.1.0</VersionPrefix>
        <AssemblyVersion>1.1.0</AssemblyVersion>
        <FileVersion>1.1.0</FileVersion>
        <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
        <Company>Evotec</Company>
        <Authors>Przemyslaw Klys</Authors>
        <Copyright>(c) 2011 - 2025 Przemyslaw Klys @ Evotec. All rights reserved.</Copyright>
        <LangVersion>Latest</LangVersion>
        <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Enforce XML docs quality in Release -->
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <WarningsAsErrors>CS1591</WarningsAsErrors>
  </PropertyGroup>

    <PropertyGroup>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <!-- PowerShell uses Magika in safe Assist mode by default and exposes an opt-out.
             C# consumers still opt in by referencing the separate provider package. -->
        <IncludeMagika Condition="'$(IncludeMagika)' == ''">true</IncludeMagika>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IncludeMagika)' == 'true'">
        <DefineConstants>$(DefineConstants);FILEINSPECTORX_MAGIKA</DefineConstants>
    </PropertyGroup>

    <PropertyGroup>
        <!-- PowerForge enriches module help from the compiler XML documentation file. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <!-- We need to remove PowerShell conflicting libraries as it will break output -->
    <Target Name="RemoveFilesAfterBuild" AfterTargets="Build">
        <Delete Files="$(OutDir)System.Management.Automation.dll" />
        <Delete Files="$(OutDir)System.Management.dll" />
    </Target>

    <ItemGroup>
        <PackageReference Include="PowerShellStandard.Library" Version="5.1.1" PrivateAssets="all" />
        <PackageReference Include="Microsoft.ML.OnnxRuntime"
                          Version="1.29.0"
                          GeneratePathProperty="true"
                          PrivateAssets="all"
                          Condition="'$(IncludeMagika)' == 'true'" />
        <None Include="..\Module\en-US\FileInspectorX-help.xml"
              Link="en-US\FileInspectorX.PowerShell.dll-Help.xml"
              CopyToOutputDirectory="PreserveNewest"
              CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\FileInspectorX\FileInspectorX.csproj" />
        <ProjectReference Include="..\FileInspectorX.Magika\FileInspectorX.Magika.csproj"
            Condition="'$(IncludeMagika)' == 'true'" />
    </ItemGroup>

    <ItemGroup Condition="'$(IncludeMagika)' == 'true'">
        <None Include="..\FileInspectorX.Magika\THIRD-PARTY-NOTICES.md"
              Link="THIRD-PARTY-NOTICES.md"
              CopyToOutputDirectory="PreserveNewest"
              CopyToPublishDirectory="PreserveNewest" />
        <None Include="..\FileInspectorX.Magika\THIRD-PARTY-LICENSES\Magika-Apache-2.0.txt"
              Link="THIRD-PARTY-LICENSES\Magika-Apache-2.0.txt"
              CopyToOutputDirectory="PreserveNewest"
              CopyToPublishDirectory="PreserveNewest" />
        <None Include="..\FileInspectorX.Magika\THIRD-PARTY-LICENSES\ONNX-Runtime-MIT.txt"
              Link="THIRD-PARTY-LICENSES\ONNX-Runtime-MIT.txt"
              CopyToOutputDirectory="PreserveNewest"
              CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- Keep the net472 cmdlet assembly AnyCPU so 32-bit Windows PowerShell can import it.
         The x64 host uses these native companions; unsupported hosts stay deterministic-only. -->
    <Target Name="CopyNet472MagikaNativeRuntimeToBuildOutput"
            AfterTargets="Build"
            Condition="'$(IncludeMagika)' == 'true' And '$(TargetFramework)' == 'net472'">
        <ItemGroup>
            <Net472MagikaNativeRuntime Include="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\win-x64\native\onnxruntime.dll" />
            <Net472MagikaNativeRuntime Include="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\win-x64\native\onnxruntime_providers_shared.dll" />
        </ItemGroup>
        <Copy SourceFiles="@(Net472MagikaNativeRuntime)"
              DestinationFolder="$(OutDir)"
              SkipUnchangedFiles="true" />
    </Target>

    <!-- PowerForge publishes without one RuntimeIdentifier so that a single PowerShell module
         can serve every supported host. Populate the publish tree with only the native assets
         that the loader supports; PowerForge then preserves these runtimeTarget paths. -->
    <Target Name="CopyMagikaNativeRuntimesToPublishOutput"
            AfterTargets="Publish"
            Condition="'$(IncludeMagika)' == 'true'">
        <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
            <MagikaPublishNativeRuntime Include="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\linux-arm64\native\libonnxruntime.so">
                <RelativePath>runtimes/linux-arm64/native/libonnxruntime.so</RelativePath>
            </MagikaPublishNativeRuntime>
            <MagikaPublishNativeRuntime Include="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\linux-arm64\native\libonnxruntime_providers_shared.so">
                <RelativePath>runtimes/linux-arm64/native/libonnxruntime_providers_shared.so</RelativePath>
            </MagikaPublishNativeRuntime>
            <MagikaPublishNativeRuntime Include="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\linux-x64\native\libonnxruntime.so">
                <RelativePath>runtimes/linux-x64/native/libonnxruntime.so</RelativePath>
            </MagikaPublishNativeRuntime>
            <MagikaPublishNativeRuntime Include="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\linux-x64\native\libonnxruntime_providers_shared.so">
                <RelativePath>runtimes/linux-x64/native/libonnxruntime_providers_shared.so</RelativePath>
            </MagikaPublishNativeRuntime>
            <MagikaPublishNativeRuntime Include="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\osx-arm64\native\libonnxruntime.dylib">
                <RelativePath>runtimes/osx-arm64/native/libonnxruntime.dylib</RelativePath>
            </MagikaPublishNativeRuntime>
            <MagikaPublishNativeRuntime Include="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\win-arm64\native\onnxruntime.dll">
                <RelativePath>runtimes/win-arm64/native/onnxruntime.dll</RelativePath>
            </MagikaPublishNativeRuntime>
            <MagikaPublishNativeRuntime Include="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\win-arm64\native\onnxruntime_providers_shared.dll">
                <RelativePath>runtimes/win-arm64/native/onnxruntime_providers_shared.dll</RelativePath>
            </MagikaPublishNativeRuntime>
            <MagikaPublishNativeRuntime Include="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\win-x64\native\onnxruntime.dll">
                <RelativePath>runtimes/win-x64/native/onnxruntime.dll</RelativePath>
            </MagikaPublishNativeRuntime>
            <MagikaPublishNativeRuntime Include="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\win-x64\native\onnxruntime_providers_shared.dll">
                <RelativePath>runtimes/win-x64/native/onnxruntime_providers_shared.dll</RelativePath>
            </MagikaPublishNativeRuntime>
        </ItemGroup>
        <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
            <MagikaPublishNativeRuntime Include="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\win-x64\native\onnxruntime.dll">
                <RelativePath>onnxruntime.dll</RelativePath>
            </MagikaPublishNativeRuntime>
            <MagikaPublishNativeRuntime Include="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\win-x64\native\onnxruntime_providers_shared.dll">
                <RelativePath>onnxruntime_providers_shared.dll</RelativePath>
            </MagikaPublishNativeRuntime>
        </ItemGroup>
        <Copy SourceFiles="@(MagikaPublishNativeRuntime)"
              DestinationFiles="@(MagikaPublishNativeRuntime->'$(PublishDir)%(RelativePath)')"
              SkipUnchangedFiles="true" />
    </Target>
</Project>
