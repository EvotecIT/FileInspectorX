<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <VersionPrefix>1.1.7</VersionPrefix>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../FileInspectorX/FileInspectorX.csproj" />
    <ProjectReference Include="../FileInspectorX.OfficeIMO/FileInspectorX.OfficeIMO.csproj" />
    <None Update="wwwroot/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
